# Nam AI backend environment template. No real secrets here.
# Copy each section into the file named in its header (paths relative to this repo), then fill in real values.
# Keep this file in sync with Appendix C of docs/IMPLEMENTATION_PLAN.md.

# ============================================================
# .env  (agent API, repo root)
# ============================================================
APP_ENV=dev
LOG_LEVEL=INFO

# Database (SQLAlchemy/asyncpg), tests, and the LangGraph checkpointer (psycopg)
DATABASE_URL=postgresql+asyncpg://nam:nam@localhost:5432/nam_ai
TEST_DATABASE_URL=postgresql+asyncpg://nam:nam@localhost:5432/nam_ai_test
CHECKPOINT_DATABASE_URL=postgresql://nam:nam@localhost:5432/nam_ai

# Auth0 (token issuer, audience, custom-claim prefix)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.nam-ai.local
AUTH0_CLAIM_NAMESPACE=https://nam-ai/

# Models, as provider:model. Local now; later anthropic:claude-sonnet-5-5 / anthropic:claude-haiku-5-5
COORDINATOR_MODEL=ollama:qwen3:14b
HELPER_MODEL=ollama:qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=32768
# Leave empty until plan Step 4.10
ANTHROPIC_API_KEY=

# RAG MCP server and tool-list cache
TAXRAG_MCP_URL=http://localhost:8100/mcp
MCP_TOOL_CACHE_SECONDS=300

# Tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nam-ai-dev

# ============================================================
# infra/.env
# ============================================================
POSTGRES_USER=nam
POSTGRES_PASSWORD=nam
POSTGRES_DB=nam_ai
# Optional bearer token for the stub RAG server
STUB_RAG_TOKEN=
